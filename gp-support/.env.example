DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/gp-support

# Supabase example:
# DATABASE_URL=postgresql+psycopg://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres?sslmode=require

# Groq
GROQ_API_KEY=

# RAG
BUILD_RAG_INDEX=False

# AWS
AWS_REGION=ap-southeast-2
AWS_PROFILE=your_aws_profile_name

# Amazon Bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Amazon Transcribe Streaming
TRANSCRIBE_LANGUAGE_OPTIONS=en-US,zh-CN,th-TH,ru-RU,es-US

# Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Amazon SES
SES_FROM_EMAIL=no-reply@your-domain.com

# Email verification
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
